# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# TukTuk24 Backend API Base URL and Authentication Key
# Configure in the Secrets panel or .env file
TUKTUK24_API_BASE_URL=https://api.tuktuk24lisbon.com/api/v1
TUKTUK24_API_KEY=YOUR_TUKTUK24_API_KEY

# Google Web Client ID for Credential Manager sign-in
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
